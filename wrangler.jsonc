{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "free-model-radar",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "RADAR_KV",
      "id": "61d770461a7f4dc788d189380b0a9cf4",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "RADAR_DB",
      "database_name": "free-model-radar",
      // 部署前用 `wrangler d1 create free-model-radar` 的返回值替换此占位 ID。
      "database_id": "14266221-9f14-43d5-bd20-3cfea6c1c4e3",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REFRESH_QUEUE",
        "queue": "refresh-queue"
      },
      {
        "binding": "SVG_EVALUATION_QUEUE",
        "queue": "svg-evaluation-queue"
      }
    ],
    "consumers": [
      {
        "queue": "refresh-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 60,
        "max_retries": 3
      },
      {
        "queue": "svg-evaluation-queue",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "max_concurrency": 2
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/30 * * * *",
      "7 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
